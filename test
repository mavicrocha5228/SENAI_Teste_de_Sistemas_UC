import unittest
import sqlite3 
import os 
import database as db

#PARA TESTAR O CADASTRO DO LIVRO, VER SE TA COERENTE, TA BACANA, TA SHOW

class TestCadastroLivro(unittest.TestCase): 

    def setUp(self): 
       self.banco_teste = "banco_teste.db" 
       db.criar_tabela(nome_banco=self.banco_teste) 


    def tearDown(self):

        if os.path.exists(self.banco_teste):
                os.remove(self.banco_teste)
        
#VER SE ESTA CADASTRANDO COM JOÃO PEDRO GUIMARÃES 

    def test_cadastrar_livro_com_sucesso(self): 
        db.cadastro_livro("A Metamorfose", "Franz Kafka", 1915, 
                          self.banco_teste)

        conn = sqlite3.connect(self.banco_teste)
        cursor = conn.cursor()
        cursor.execute ("SELECT * FROM livros WHERE titulo = 'A Metamorfose' ")
        livro_salvo = cursor.fetchone()
        conn.close()

        self.assertIsNotNone(livro_salvo, "O livro não esta cadastrado") 
        self.assertEqual(livro_salvo[1], "A Metamorfose") 
        self.assertEqual(livro_salvo[2], "Franz Kafka") 
        self.assertEqual(livro_salvo[3], 1915) 


#VER SE TA DELETANDO COM JOÃO PEDRO GUIMARÃES 

class TestDeletarLivro(unittest.TestCase):

    def setUp(self): 
        self.banco_teste = "banco_teste.db"
        db.criar_tabela(nome_banco=self.banco_teste) 

    def tearDown(self):
        if os.path.exists(self.banco_teste):
            os.remove(self.banco_teste)
            

    def test_delete_livro_com_sucesso(self): 

        db.cadastro_livro("A Metamorfose", "Franz Kafka", 1915, 
                          self.banco_teste)

        conn = sqlite3.connect(self.banco_teste)
        cursor = conn.cursor()
        cursor.execute ("SELECT * FROM livros WHERE titulo = 'A Metamorfose' ")
        livro = cursor.fetchone()
        conn.close()

        id_livro= livro [0] 
        msg= db.delete_livro(id_livro, nome_banco= self.banco_teste)

        self.assertTrue(msg)#aqui testa se o livro foi deletado MSM
        

if __name__ == "__main__": 
    unittest.main()

